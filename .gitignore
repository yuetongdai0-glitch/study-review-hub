# macOS 系统文件
.DS_Store

# 本地工程数据（记忆 / 会话信息，不上传公开仓库）
.workbuddy/

# 编辑器 / IDE 的本地状态（每个人的都不一样，不该入库）
.idea/
.vscode/*
!.vscode/extensions.json

# WorkBuddy 本地生成的应用卡
*.genie

# 依赖与日志
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# 构建产物
#
# 用通配 `dist*/` 而不是逐个列 dist / dist-mobile：
# 之前漏了 dist-standalone（67 个文件、7.7MB），整包产物全冒进源代码管理面板，
# 一眼看过去像有几十个改动。以后再加 dist-xxx 也不用回来补。
apps/web/dist*/
apps/web/.smoke/
apps/mobile/dist/
apps/mobile/build/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/build/
apps/mobile/ios/App/App/public/

# 签名材料（含口令，禁止入库；请自行离线备份 android/keystore）
apps/mobile/android/keystore/
apps/mobile/android/app/keystore.properties

# 原始讲义 / 笔记 PDF（体积大，约 100MB；站点内容已内化到页面，不入库）
临时资料/
素材/
