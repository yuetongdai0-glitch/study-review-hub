{
  "name": "@study-hub/web",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "description": "备考复习知识库（React + Vite + Ant Design + Tailwind + Zustand，路由化模块）",
  "scripts": {
    "dev": "vite --port 8770 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:mobile": "tsc --noEmit && vite build --mode mobile",
    "build:only": "vite build",
    "preview": "vite preview --port 8770 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "antd": "^6.1.3",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
